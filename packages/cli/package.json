{
  "name": "seatmesh",
  "version": "1.2.5",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "profiles",
    "templates"
  ],
  "bin": {
    "sm": "bin/sm",
    "seatmesh": "bin/seatmesh"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node scripts/bundle-profiles.ts && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@seat-mesh/connectivity": "^1.2.5",
    "@seat-mesh/core": "^1.2.5",
    "@seat-mesh/daemon": "^1.2.5",
    "@seat-mesh/providers": "^1.2.5",
    "@seat-mesh/tmux": "^1.2.5",
    "boxen": "^8.0.1",
    "cfonts": "^3.3.1",
    "commander": "^15.0.0",
    "yaml": "^2.7.0"
  }
}
