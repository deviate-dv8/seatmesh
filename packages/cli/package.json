{
  "name": "seatmesh",
  "version": "0.1.8",
  "type": "module",
  "files": [
    "dist",
    "profiles",
    "templates"
  ],
  "bin": {
    "seatmesh": "dist/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node scripts/bundle-profiles.mjs && npm run build"
  },
  "dependencies": {
    "@seat-mesh/connectivity": "0.1.8",
    "@seat-mesh/core": "0.1.8",
    "@seat-mesh/daemon": "0.1.8",
    "@seat-mesh/providers": "0.1.8",
    "@seat-mesh/tmux": "0.1.8",
    "commander": "^15.0.0"
  }
}
