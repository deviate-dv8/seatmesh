{
  "name": "@seat-mesh/web-waygraph",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Waygraph E2E blocks + flows for the seatmesh operator hub (:3190).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:reuse": "SEATMESH_WG_REUSE=1 WAYGRAPH_BASE_URL=http://127.0.0.1:3190 playwright test",
    "flows": "waygraph list .",
    "check": "waygraph check .",
    "auto": "waygraph auto .",
    "demo": "waygraph demo hubSmokeFlow .",
    "demo:step": "waygraph demo hubSmokeFlow . --step --no-autoplay --title \"Hub smoke\""
  },
  "waygraph": {
    "baseUrl": "http://127.0.0.1:3191"
  },
  "dependencies": {
    "waygraph": "0.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0"
  }
}
