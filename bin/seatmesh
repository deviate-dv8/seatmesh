#!/usr/bin/env bash
# seatmesh CLI entry (product-agnostic). Consumers: --profile <dir|yaml>
set -euo pipefail
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
CLI="$ROOT/packages/cli/dist/main.js"
PKG="$ROOT/package.json"

needs=0
[[ -f "$CLI" ]] || needs=1
[[ -d "$ROOT/node_modules" ]] || needs=1
if [[ -f "$PKG" && -f "$CLI" && "$PKG" -nt "$CLI" ]]; then
  needs=1
fi

if [[ "$needs" -eq 1 ]]; then
  if ! command -v npm >/dev/null 2>&1; then
    echo "seatmesh: npm not found (need Node/npm for cold start build)" >&2
    exit 1
  fi
  echo "seatmesh: cold start — npm install + build in $ROOT ..." >&2
  (cd "$ROOT" && npm install && npm run build)
fi

exec node "$CLI" "$@"
